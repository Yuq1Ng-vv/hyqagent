# HyqAgent 环境配置
# 复制此文件为 .env 并填入你的值
# .env 已加入 .gitignore — 绝不提交密钥

# ─── 运行环境 ───
HYQAGENT_ENVIRONMENT=development      # development | staging | production
HYQAGENT_DEBUG=true

# ─── LLM API 密钥 ───
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...               # Kimi/GLM 兼容使用

# ─── 模型配置 ───
HYQAGENT_DEFAULT_MODEL=claude-sonnet-4-6
HYQAGENT_FAST_MODEL=claude-haiku-4-6
HYQAGENT_POWERFUL_MODEL=claude-opus-4-6
HYQAGENT_MAX_TOKENS=4096
HYQAGENT_TEMPERATURE=0.1

# ─── 审计配置 ───
HYQAGENT_MAX_COST_PER_PROJECT=5.0
HYQAGENT_MAX_AUDIT_ITERATIONS=10
HYQAGENT_PARALLEL_WORKERS=4

# ─── CPG 工具 ───
HYQAGENT_JOERN_CLI_PATH=/usr/local/bin/joern

# ─── 存储 ───
HYQAGENT_DATABASE_URL=sqlite:///~/.hyqagent/state.db

# ─── 可观测性 ───
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ─── 日志 ───
HYQAGENT_LOG_LEVEL=INFO
HYQAGENT_LOG_FORMAT=json
