# ============================================================================
# .env.openai — 全部 LLM 层使用 OpenAI 格式 API 的示例配置
#
# 用法：复制为 .env，按需修改 api_key 和 model 名称
#   cp .env.openai .env
#   # 编辑 .env 填入实际 key
#   hyqagent scan ./app --lang python --deep
#
# 支持任意 OpenAI 兼容服务：DeepSeek / OpenAI / Kimi / Qwen / one-api / LiteLLM
# ============================================================================

# ── Provider 选择（每层独立）──────────────────────────────────────────────
# 可选值: anthropic | openai
# 默认都是 anthropic，这里全部切到 openai
HYQAGENT_CHEAP_PROVIDER=openai
HYQAGENT_MID_PROVIDER=openai
HYQAGENT_STRONG_PROVIDER=openai

# ── 模型名（每层独立）──────────────────────────────────────────────────────
# CHEAP 层 — 复杂度 1-4 的任务用便宜模型
HYQAGENT_CHEAP_MODEL=deepseek-chat

# MID 层 — 复杂度 5-7 的任务用中等模型
HYQAGENT_MID_MODEL=deepseek-chat

# STRONG 层 — 复杂度 8-10 的任务用最强模型
HYQAGENT_STRONG_MODEL=deepseek-chat

# ── API Key ────────────────────────────────────────────────────────────────
# 必填。也支持环境变量 OPENAI_API_KEY
HYQAGENT_OPENAI_API_KEY=sk-your-key-here

# ── Base URL（决定走哪个服务）─────────────────────────────────────────────
# DeepSeek OpenAI 兼容端点
HYQAGENT_OPENAI_BASE_URL=https://api.deepseek.com/v1

# 其他常见服务（取消注释即可）:
# OpenAI 官方:
# HYQAGENT_OPENAI_BASE_URL=
#
# Kimi (月之暗面):
# HYQAGENT_OPENAI_BASE_URL=https://api.moonshot.cn/v1
#
# Qwen (通义千问):
# HYQAGENT_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# one-api / LiteLLM 网关:
# HYQAGENT_OPENAI_BASE_URL=https://your-gateway.example.com/v1

# ── 可选：预算与重试 ───────────────────────────────────────────────────────
# 单次扫描最大 LLM 费用（美元），默认 $1.39
# HYQAGENT_MAX_LLM_BUDGET=1.39
#
# LLM 调用最大重试次数，默认 3
# HYQAGENT_LLM_MAX_RETRIES=3
#
# LLM 调用超时秒数，默认 120
# HYQAGENT_LLM_TIMEOUT_SECONDS=120

# ── 可选：混用示例（如果需要 CHEAP OpenAI + STRONG Claude）───────────────
# HYQAGENT_CHEAP_PROVIDER=openai
# HYQAGENT_CHEAP_MODEL=gpt-4o-mini
# HYQAGENT_STRONG_PROVIDER=anthropic
# HYQAGENT_STRONG_MODEL=claude-opus-5
# HYQAGENT_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
